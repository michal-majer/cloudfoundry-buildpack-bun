#!/usr/bin/env bash
# Cloud Foundry Bun Buildpack - finalize script
# Installs dependencies and runs build

set -euo pipefail

BUILD_DIR="${1:-}"
CACHE_DIR="${2:-}"
DEPS_DIR="${3:-}"
DEPS_IDX="${4:-}"
PROFILE_DIR="${5:-}"

if [[ -z "$BUILD_DIR" ]] || [[ -z "$CACHE_DIR" ]] || [[ -z "$DEPS_DIR" ]] || [[ -z "$DEPS_IDX" ]]; then
  echo "Usage: finalize BUILD_DIR CACHE_DIR DEPS_DIR DEPS_IDX [PROFILE_DIR]" >&2
  exit 1
fi

BUN_BIN="$DEPS_DIR/$DEPS_IDX/bin/bun"
NODE_MODULES_CACHE="$CACHE_DIR/node_modules"

if [[ ! -x "$BUN_BIN" ]]; then
  echo "ERROR: Bun binary not found at $BUN_BIN" >&2
  exit 1
fi

cd "$BUILD_DIR"

# Restore cached node_modules if exists and lockfile hasn't changed
LOCKFILE_HASH=""
if [[ -f "bun.lockb" ]]; then
  LOCKFILE_HASH=$(md5sum bun.lockb | cut -d' ' -f1)
fi

CACHED_HASH_FILE="$CACHE_DIR/.lockfile_hash"
CACHED_HASH=""
if [[ -f "$CACHED_HASH_FILE" ]]; then
  CACHED_HASH=$(cat "$CACHED_HASH_FILE")
fi

# Install function that handles lockfile changes gracefully
install_deps() {
  set +e
  "$BUN_BIN" install --frozen-lockfile 2>&1 | sed 's/^/       /'
  local exit_code=${PIPESTATUS[0]}
  set -e

  if [[ $exit_code -ne 0 ]]; then
    echo "       Lockfile had platform-specific changes, running regular install..."
    "$BUN_BIN" install 2>&1 | sed 's/^/       /'
  fi
}

if [[ -n "$LOCKFILE_HASH" ]] && [[ "$LOCKFILE_HASH" == "$CACHED_HASH" ]] && [[ -d "$NODE_MODULES_CACHE" ]]; then
  echo "-----> Restoring cached node_modules"
  cp -r "$NODE_MODULES_CACHE" ./node_modules
  echo "-----> Running bun install to verify dependencies"
  install_deps
else
  echo "-----> Installing dependencies with Bun"
  install_deps

  # Cache node_modules
  if [[ -d "node_modules" ]]; then
    echo "-----> Caching node_modules for future builds"
    rm -rf "$NODE_MODULES_CACHE"
    cp -r node_modules "$NODE_MODULES_CACHE"
    echo "$LOCKFILE_HASH" > "$CACHED_HASH_FILE"
  fi
fi

# Run build script if it exists in package.json (skip if BUN_SKIP_BUILD=true)
if [[ "${BUN_SKIP_BUILD:-}" != "true" ]] && [[ -f "package.json" ]]; then
  if grep -q '"build"' package.json 2>/dev/null; then
    # Skip build for monorepo root (avoid recursive build scripts)
    if grep -q '"workspaces"' package.json 2>/dev/null; then
      echo "-----> Skipping build script (monorepo root detected)"
    else
      echo "-----> Running build script"
      "$BUN_BIN" run build 2>&1 | sed 's/^/       /' || true
    fi
  fi

  # Run heroku-postbuild if it exists (Heroku compatibility)
  if grep -q '"heroku-postbuild"' package.json 2>/dev/null; then
    echo "-----> Running heroku-postbuild script"
    "$BUN_BIN" run heroku-postbuild 2>&1 | sed 's/^/       /'
  fi
fi

# Prune devDependencies for production
if [[ "${NODE_ENV:-}" == "production" ]] || [[ "${BUN_PRUNE:-true}" == "true" ]]; then
  echo "-----> Pruning devDependencies"
  "$BUN_BIN" install --production 2>&1 | sed 's/^/       /' || true
fi

# Ensure bun is available at runtime by copying to app's bin directory
mkdir -p "$BUILD_DIR/.profile.d"

# Set up PATH for bun
cat > "$BUILD_DIR/.profile.d/000_bun.sh" << 'EOF'
export PATH="$HOME/bin:$PATH"
export BUN_INSTALL="$HOME"
EOF

# Extract secrets from VCAP_SERVICES user-provided services
cat > "$BUILD_DIR/.profile.d/001_vcap_secrets.sh" << 'VCAP_SCRIPT'
#!/usr/bin/env bash
# Extract credentials from user-provided services named 'secrets' or 'config'
if [ -n "$VCAP_SERVICES" ]; then
  # Use bun to parse JSON and export env vars
  eval "$($HOME/bin/bun -e "
    const vcap = JSON.parse(process.env.VCAP_SERVICES || '{}');
    const ups = vcap['user-provided'] || [];
    const secrets = ups.find(s => s.name.includes('secrets') || s.name.includes('config'));
    if (secrets?.credentials) {
      for (const [key, value] of Object.entries(secrets.credentials)) {
        if (typeof value === 'string') {
          console.log('export ' + key + '=' + JSON.stringify(value));
        }
      }
    }
  ")"
fi
VCAP_SCRIPT
chmod +x "$BUILD_DIR/.profile.d/001_vcap_secrets.sh"

mkdir -p "$BUILD_DIR/bin"
cp "$BUN_BIN" "$BUILD_DIR/bin/bun"
chmod +x "$BUILD_DIR/bin/bun"

echo "-----> Build complete"
